# turnkey credentials (from dashboard: user details -> create api key)
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# the EOA to receive USDC refunds + leftover ETH from sweep-gas
REFUND_ADDRESS=

# base mainnet RPC. the public one is fine for low-volume scripts;
# swap in alchemy/infura/etc. if you hit rate limits.
BASE_RPC_URL=https://mainnet.base.org

# optional overrides
# how much ETH to top each test wallet up with before refunding (in wei)
# 0.00005 ETH — ~70x what one base ERC20 transfer actually needs on base
GAS_TOPUP_WEI=50000000000000

# how many test wallets to create / operate on
TEST_WALLET_COUNT=10
